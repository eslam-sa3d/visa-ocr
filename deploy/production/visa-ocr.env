# Production settings for visa-ocr. Used by docker-compose.yml in this folder.
# Lines marked DECIDE need a value from your own measurements or policy before go-live.

PRODUCTION=1                                   # refuses to start in any unsafe set-up and says why in the logs
OCR_ENGINE=auto                                # PaddleOCR first, Tesseract + RapidOCR as the second pair

# Access: keys with roles and expiry dates (make them with make_keys.py; the file holds digests, never the keys)
API_KEYS_FILE=/etc/visa-ocr/keys.json

# Personal data at rest: jobs, results and errors are encrypted with this key. Keep it on a different volume from /data.
DATA_KEY_FILE=/etc/visa-ocr/data.key
DATA_CIPHER=aes256gcm
JOB_DB_PATH=/data/jobs.db

# HTTPS with your organisation's certificate (a self-signed one is refused in production)
TLS_CERT=/etc/visa-ocr/tls/server.crt
TLS_KEY=/etc/visa-ocr/tls/server.key

# Security events, one JSON line each, no personal data. Ship this file to the SIEM.
AUDIT_LOG_FILE=/var/log/visa-ocr/audit.log

# Image clarity: turn back unusable photos at once and attach a retake message to unclear readings
IMAGE_QUALITY_CHECK=1

# DECIDE: hard limit per read, in seconds. 0 = no limit. Set it from tools/suggest_deadline.py run on THIS server with your
# own sample images; too low sends readable documents to review or retake.
OCR_DEADLINE_SECONDS=0
OCR_HANDOVER_SECONDS=12                        # limit for the second pair of readers after PaddleOCR has read the page

# Readers (documents read at the same time). Leave unset: the service starts one reader for each processor core the
# container was given, as long as each has about 2 GB of memory (6 cores and 18 GB -> 6 readers; 1 core and 2 GB -> 1).
# /readyz shows the number chosen. Set a number only to leave cores free for something else.
#READER_PROCESSES=4
#READER_MEMORY_GB=2
# Uploads allowed to wait before the service answers "busy". Unset = 32 for each reader.
#MAX_PENDING_JOBS=192
# Keeps each reader's memory near 1 GB at rest and 1.6 GB at peak (without it a 2 GB container was stopped for memory under
# load). Also set in the image.
MALLOC_ARENA_MAX=2
RATE_LIMIT_PER_MIN=0                           # the portal is the only caller; set a number if other clients are added

# DECIDE: malware scan of every upload (fails closed). Needs a scanner inside the container or reachable from it.
#UPLOAD_SCAN_COMMAND=clamdscan --no-summary

# Self-improvement: ON. The service keeps, encrypted, the images of uploads sent with consent_training=true and the
# corrections reviewers make to them, for TRAINING_RETENTION_DAYS. A correction counts only after a second person approves
# it (tools/approve_corrections.py). Retraining runs on the training machine (deploy/install_autotrain.sh), never inside
# this container, and a new model replaces the one in use only if it beats it on the golden set (docs/MODEL_TRAINING.md).
# To switch collection off, remove the next line.
TRAINING_STORE_DIR=/data/training
TRAINING_RETENTION_DAYS=30
