# Copy to /etc/visa-ocr/autotrain.env (mode 600) and fill in. Read by visa-ocr-autotrain.service.
TRAINING_STORE_DIR=/data/visa-ocr/training-store
AUTOTRAIN_WORK_DIR=/data/visa-ocr/autotrain
MODELS_DIR=/opt/visa-ocr/models
AUTOTRAIN_LANG=ar
AUTOTRAIN_ARCH=arabic_PP-OCRv5_mobile_rec
# Extra options. Add --activate here only after a few runs have been checked by hand.
AUTOTRAIN_ARGS=--dict /opt/visa-ocr/models/arabic_dict.txt
# Used by training/finetune.sh
PADDLEOCR_DIR=/opt/PaddleOCR
BASE_CONFIG=configs/rec/PP-OCRv5/multi_language/arabic_PP-OCRv5_mobile_rec.yaml
PRETRAINED=/opt/pretrained/arabic_PP-OCRv5_mobile_rec_pretrained
USE_GPU=true
EPOCHS=30
