# Copy to /etc/visa-ocr/autotrain.env (mode 600) and fill in. Read by visa-ocr-autotrain.service.
TRAINING_STORE_DIR=/data/visa-ocr/training-store
AUTOTRAIN_WORK_DIR=/data/visa-ocr/autotrain
MODELS_DIR=/opt/visa-ocr/models
AUTOTRAIN_LANG=ar
AUTOTRAIN_ARCH=arabic_PP-OCRv5_mobile_rec
# Extra options. Add --activate here only after a few runs have been checked by hand.
# --golden-dir is the fixed test set a new model is judged on (labels.txt + line images). Keep it OUTSIDE the training store;
# without it a candidate is built but never compared or activated.
AUTOTRAIN_ARGS=--dict /opt/visa-ocr/models/arabic_dict.txt --golden-dir /data/visa-ocr/golden/ar
# Used by training/finetune.sh
PADDLEOCR_DIR=/opt/PaddleOCR
BASE_CONFIG=configs/rec/PP-OCRv5/multi_language/arabic_PP-OCRv5_mobile_rec.yaml
PRETRAINED=/opt/pretrained/arabic_PP-OCRv5_mobile_rec_pretrained
# sha256sum /opt/pretrained/arabic_PP-OCRv5_mobile_rec_pretrained.pdparams   (checked before every run)
PRETRAINED_SHA256=
# The same key as on the OCR servers, if the manifest is signed (see docs/SECURITY.md)
# MANIFEST_HMAC_KEY_FILE=/etc/visa-ocr/manifest.key
# Security events from retraining and model changes (one JSON line each, no personal data). Ship this file to the SIEM.
# Without it the events go to the journal (stderr). Run tools/approve_corrections.py, tools/purge_training.py and
# training/register_model.py with the same AUDIT_LOG_FILE so their events reach the same place.
AUDIT_LOG_FILE=/var/log/visa-ocr/autotrain-audit.log
USE_GPU=true
EPOCHS=30
